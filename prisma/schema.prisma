generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  DEBIT
  SAVINGS
  OTHER
}

enum EntryType {
  INCOME
  EXPENSE
  TRANSFER
}

model Account {
  id                   String        @id @default(uuid())
  name                 String
  type                 AccountType
  openingBalanceKopecks Int
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  outgoing            Transaction[] @relation("Source")
  incoming            Transaction[] @relation("Destination")
  goals               Goal[]
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         EntryType
  color        String
  icon         String
  isArchived   Boolean       @default(false)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([type, name])
}

model Transaction {
  id                   String    @id @default(uuid())
  type                 EntryType
  amountKopecks        Int
  date                 String
  accountId            String
  categoryId           String?
  destinationAccountId String?
  note                 String    @default("")
  createdAt            DateTime  @default(now())
  account              Account   @relation("Source", fields: [accountId], references: [id], onDelete: Restrict)
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  destinationAccount   Account?  @relation("Destination", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  @@index([date, id])
  @@index([type, date])
  @@index([categoryId, date])
  @@index([accountId, date])
  @@index([destinationAccountId, date])
}

model Budget {
  id           String   @id @default(uuid())
  categoryId   String
  month        String
  limitKopecks Int
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, month])
  @@index([month])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

model Goal {
  id            String             @id @default(uuid())
  name          String
  targetKopecks Int
  deadline      String
  status        GoalStatus         @default(ACTIVE)
  description   String             @default("")
  color         String
  accountId     String?
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contributions GoalContribution[]
}

model GoalContribution {
  id            String @id @default(uuid())
  goalId        String
  amountKopecks Int
  date          String
  goal          Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Settings {
  id           String @id @default(uuid())
  currency     String @default("RUB")
  theme        String @default("light")
  locale       String @default("ru-RU")
  weekStartsOn Int    @default(1)
}
